# ---------- Shared ----------
NODE_ENV=development

# ---------- Database ----------
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleetdb
POSTGRES_PORT=5432

# Backend Prisma connection string
DATABASE_URL=postgresql://fleet:fleet@localhost:5432/fleetdb?schema=public

# ---------- Backend ----------
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# GPS simulator
GPS_SIMULATOR_ENABLED=true
GPS_SIMULATOR_INTERVAL_MS=3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Optional: when set, the live map uses Mapbox. When empty, Leaflet + OpenStreetMap is used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------- AI service ----------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# OpenAI-compatible LLM endpoint. Leave AI_API_KEY empty to use the built-in
# deterministic assistant (no external calls, works fully offline).
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Internal bearer token the backend uses to call the AI service
AI_INTERNAL_TOKEN=change-me-internal-token
